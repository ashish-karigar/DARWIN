{
  "name": "DARWIN production RAG regression",
  "quality_gates": {
    "execution_success_min_percent": 100,
    "retrieval_source_recall_min_percent": 90,
    "retrieval_answerability_min_percent": 90,
    "strategy_accuracy_min_percent": 95,
    "answer_accuracy_min_percent": 85,
    "answer_completeness_min_percent": 90,
    "citation_recall_min_percent": 90,
    "no_answer_rejection_min_percent": 100,
    "false_abstention_max_percent": 10,
    "latency_budget_pass_min_percent": 95,
    "p95_latency_max_seconds": 30
  },
  "cases": [
    {
      "case_id": "paper-attribution",
      "question": "Who introduced retrieval-augmented generation?",
      "should_answer": true,
      "expected_source_suffixes": ["rag-paper.pdf"],
      "required_term_groups": [
        ["Patrick Lewis"],
        ["Ethan Perez"]
      ],
      "expected_strategy": "decompose",
      "maximum_latency_seconds": 15,
      "tags": ["pdf", "attribution", "multi-evidence"]
    },
    {
      "case_id": "paper-memory",
      "question": "What non-parametric memory does RAG use?",
      "should_answer": true,
      "expected_source_suffixes": ["rag-paper.pdf"],
      "required_term_groups": [
        ["dense vector index"],
        ["Wikipedia"]
      ],
      "expected_strategy": "direct",
      "maximum_latency_seconds": 10,
      "tags": ["pdf", "factual", "architecture"]
    },
    {
      "case_id": "paper-hot-swap",
      "question": "What advantage does RAG index hot-swapping provide?",
      "should_answer": true,
      "expected_source_suffixes": ["rag-paper.pdf"],
      "required_term_groups": [
        ["update", "updated", "refresh", "refreshed", "replacing the retrieval index"],
        ["test time", "at inference", "at inference time", "at query time", "on the fly"],
        ["without retraining", "without further training", "need further training", "without any additional training", "no additional training"]
      ],
      "forbidden_terms": ["cannot be updated"],
      "expected_strategy": "direct",
      "maximum_latency_seconds": 10,
      "tags": ["pdf", "factual", "paraphrase"]
    },
    {
      "case_id": "paper-rag-variants",
      "question": "Compare RAG-Token and RAG-Sequence.",
      "should_answer": true,
      "expected_source_suffixes": ["rag-paper.pdf"],
      "required_term_groups": [
        ["RAG-Token"],
        ["different document for each target token", "different document per token", "change documents for each token"],
        ["RAG-Sequence"],
        ["same document to predict each target token", "same document for the sequence", "same document for every token", "conditioned on one document", "generated from a single document", "one document per generated sequence"]
      ],
      "expected_strategy": "decompose",
      "maximum_latency_seconds": 15,
      "tags": ["pdf", "comparison", "completeness"]
    },
    {
      "case_id": "paper-document-encoder",
      "question": "Why did the RAG authors keep the document encoder fixed during training?",
