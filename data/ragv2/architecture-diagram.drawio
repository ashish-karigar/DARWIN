  <diagram id="sheet3" name="03 Retrieval and Evidence Grading">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1080" pageHeight="620" math="0" shadow="0" background="#0a2c52">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="s3_q" value="Question&#10;+ conversation context" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0e3768;strokeColor=#a7c0dd;fontColor=#eef4fb;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="130" height="52" as="geometry" />
        </mxCell>

        <mxCell id="s3_qa" value="Query Analyzer&#10;deterministic patterns first,&#10;else an LLM QueryDecision" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2a1f2a;strokeColor=#ef6347;dashed=1;fontColor=#eef4fb;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="216" y="48" width="200" height="70" as="geometry" />
        </mxCell>

        <mxCell id="s3_strategy" value="strategy" style="rhombus;whiteSpace=wrap;html=1;fillColor=#0a2c52;strokeColor=#e0b354;fontColor=#e0b354;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="460" y="43" width="90" height="60" as="geometry" />
        </mxCell>

        <mxCell id="s3_1to2" value="1–2 retrieval queries&#10;run independently, below" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0e3768;strokeColor=#a7c0dd;fontColor=#eef4fb;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="660" y="56" width="200" height="54" as="geometry" />
        </mxCell>

        <mxCell id="s3_hybrid" value="Hybrid retrieval&#10;dense + lexical, RRF k=60&#10;top 20 candidates" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#123f74;strokeColor=#7fd6ec;fontColor=#eef4fb;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="460" y="146" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="s3_rerank" value="Cross-encoder rerank&#10;ms-marco-MiniLM-L6-v2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#123f74;strokeColor=#7fd6ec;fontColor=#eef4fb;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="460" y="236" width="200" height="54" as="geometry" />
        </mxCell>

        <mxCell id="s3_decisive" value="reranker score&#10;decisive?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#0a2c52;strokeColor=#e0b354;fontColor=#e0b354;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="490" y="318" width="140" height="84" as="geometry" />
        </mxCell>

        <mxCell id="s3_corrob" value="Corroboration shortcut&#10;directly_answers = true&#10;no LLM call — most real queries&#10;land here in a small corpus" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#123f74;strokeColor=#7fd6ec;fontColor=#eef4fb;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="296" width="212" height="70" as="geometry" />
        </mxCell>

        <mxCell id="s3_fastpath" value="Fast-path, anchor check&#10;accepts if query terms overlap the passage; else rejects&#10;still no LLM call either way — a correct paraphrase can lose" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#123f74;strokeColor=#7fd6ec;fontColor=#eef4fb;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="392" width="212" height="86" as="geometry" />
        </mxCell>

        <mxCell id="s3_llmjudge" value="LLM evidence judge&#10;Ollama qwen3:8b, batched per query&#10;told to credit hedged &quot;why&quot; reasoning and definitional over incidental passages" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2a1f2a;strokeColor=#ef6347;dashed=1;fontColor=#eef4fb;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="820" y="310" width="200" height="100" as="geometry" />
        </mxCell>

        <mxCell id="s3_ctx" value="Context Builder → Sheet 04" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0e3768;strokeColor=#a7c0dd;fontColor=#eef4fb;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="524" width="320" height="30" as="geometry" />
        </mxCell>

        <mxCell id="s3_e1" style="endArrow=block;html=1;strokeColor=#a7c0dd;" edge="1" parent="1" source="s3_q" target="s3_qa"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s3_e2" style="endArrow=block;html=1;strokeColor=#a7c0dd;" edge="1" parent="1" source="s3_qa" target="s3_strategy"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s3_e3" value="direct / decompose / step-back / conversation" style="endArrow=block;html=1;strokeColor=#a7c0dd;fontColor=#a7c0dd;fontSize=9;" edge="1" parent="1" source="s3_strategy" target="s3_1to2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s3_e4" style="endArrow=block;html=1;strokeColor=#a7c0dd;" edge="1" parent="1" source="s3_1to2" target="s3_hybrid"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s3_e5" style="endArrow=block;html=1;strokeColor=#a7c0dd;" edge="1" parent="1" source="s3_hybrid" target="s3_rerank"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s3_e6" style="endArrow=block;html=1;strokeColor=#e0b354;strokeWidth=2;" edge="1" parent="1" source="s3_rerank" target="s3_decisive"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s3_e7" value="dense+lexical agree strongly" style="endArrow=block;html=1;strokeColor=#a7c0dd;fontColor=#a7c0dd;fontSize=9;" edge="1" parent="1" source="s3_decisive" target="s3_corrob"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s3_e8" value="score ≥0.85, not corroborated" style="endArrow=block;html=1;strokeColor=#a7c0dd;fontColor=#a7c0dd;fontSize=9;" edge="1" parent="1" source="s3_decisive" target="s3_fastpath"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s3_e9" value="ambiguous middle band" style="endArrow=block;html=1;strokeColor=#a7c0dd;fontColor=#a7c0dd;fontSize=9;" edge="1" parent="1" source="s3_decisive" target="s3_llmjudge"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s3_e10" style="endArrow=block;html=1;strokeColor=#a7c0dd;" edge="1" parent="1" source="s3_corrob" target="s3_ctx"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s3_e11" style="endArrow=block;html=1;strokeColor=#a7c0dd;" edge="1" parent="1" source="s3_fastpath" target="s3_ctx"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s3_e12" style="endArrow=block;html=1;strokeColor=#a7c0dd;" edge="1" parent="1" source="s3_llmjudge" target="s3_ctx"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="sheet4" name="04 Generation Verification and Control Loop">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1080" pageHeight="540" math="0" shadow="0" background="#0a2c52">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="s4_ctx" value="Context&#10;from Sheet 03" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0e3768;strokeColor=#a7c0dd;fontColor=#eef4fb;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="150" height="46" as="geometry" />
        </mxCell>

        <mxCell id="s4_suff" value="evidence&#10;sufficient?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#0a2c52;strokeColor=#e0b354;fontColor=#e0b354;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="176" y="55" width="120" height="48" as="geometry" />
        </mxCell>

        <mxCell id="s4_rewrite" value="Rewrite the need&#10;Ollama, one attempt" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2a1f2a;strokeColor=#ef6347;dashed=1;fontColor=#eef4fb;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="136" y="150" width="200" height="52" as="geometry" />
        </mxCell>

        <mxCell id="s4_correct" value="Corrective retrieval&#10;re-run Sheet 03 for it" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#123f74;strokeColor=#7fd6ec;fontColor=#eef4fb;fontSize=11;" vertex="1" parent="1">
